APP_ENV=development
PORT=8080

# Postgres connection. Used directly by the backend (internal/config builds
# the DSN from these) and by docker-compose (postgres & migrate services).
# For a managed provider (Supabase, RDS, etc.), use the host/port/user/
# password/db from your project's connection info page and set
# DB_SSLMODE=require.
DB_HOST=localhost
DB_PORT=5432
DB_USER=change-me
DB_PASSWORD=change-me
DB_NAME=postgres
DB_SSLMODE=disable

LOG_LEVEL=info

# Length of generated club join codes.
JOIN_CODE_LENGTH=6

# Secret used to HMAC player session tokens before storing their hash.
# Generate one with: openssl rand -hex 32
PLAYER_TOKEN_SECRET=change-me-to-a-random-32-byte-secret

CORS_ORIGINS=http://localhost:5173

# Redis (e.g. a Redis Cloud free-tier database) — used only for the v2
# device-identity linking index (device_id -> player_id per club), not for
# session/match state, so a small free-tier instance is plenty.
# Get these from your Redis Cloud database's "Connect" page. Leave
# REDIS_HOST unset to disable device-identity linking (v2 falls back to v1
# behavior: every join creates a new player identity).
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=change-me
REDIS_TLS=false
